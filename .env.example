# Copy this file to hw4/.env and fill in real values. hw4/.env is git-ignored; never commit it.
# Variables already set in your shell environment take precedence over this file.

# Required for the shop assistant chat: your Portkey API key.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: use OpenAI directly instead of Portkey (used only if PORTKEY_API_KEY is empty).
# OPENAI_API_KEY=your-openai-api-key-here

# Optional: override the gateway URL (defaults to https://api.portkey.ai/v1 for Portkey,
# https://api.openai.com/v1 for OpenAI).
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: a long random string that signs login cookies, so users stay logged in across
# backend restarts. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=replace-with-a-long-random-string

# Optional: chat rate limits per shopper (logged-in account or browser address).
# Defaults: 10 messages per minute and 60 per hour. Lower them to test the limit message.
# CHAT_RATE_LIMIT_PER_MINUTE=10
# CHAT_RATE_LIMIT_PER_HOUR=60
